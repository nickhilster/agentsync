{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentSync Handoffs Schema",
  "description": "Schema for .agentsync/handoffs.json — machine-readable handoff records.",
  "type": "object",
  "required": ["version", "handoffs"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["handoff_id", "task_id", "from_agent", "to_agents", "owner_mode", "status", "created_at"],
        "additionalProperties": false,
        "properties": {
          "handoff_id": { "type": "string" },
          "task_id": { "type": ["string", "null"] },
          "from_agent": { "type": "string", "pattern": "^[a-z0-9_\\-]+$", "description": "canonical agent id (lowercase)" },
          "to_agents": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" }, "minItems": 0 },
          "owner_mode": { "type": "string", "enum": ["single", "shared", "auto"] },
          "status": { "type": "string", "enum": ["queued", "in_progress", "blocked", "ready_for_review", "approved", "merged", "escalated"] },
          "required_capabilities": { "type": "array", "items": { "type": "string" } },
          "summary": { "type": "string" },
          "notes": { "type": ["string", "null"] },
          "no_handoff_reason": { "type": ["string", "null"] },
          "generated_prompt_lines": { "type": "array", "items": { "type": "string" } },
          "prompt_copied_to_clipboard": { "type": "boolean" },
          "summary_source": { "type": "string", "enum": ["user", "deterministic"] },
          "automation_context": { "type": ["string", "null"] },
          "files": { "type": "array", "items": { "type": "string" } },
          "branch": { "type": ["string", "null"] },
          "commit": { "type": ["string", "null"] },
          "recommended_model_tier": {
            "type": ["string", "null"],
            "enum": ["worker", "lead", null],
            "description": "Recommended model tier for this handoff task. 'worker' for routine edits, 'lead' for complex reasoning."
          },
          "model_justification": {
            "type": ["string", "null"],
            "description": "Technical justification for the recommended model tier."
          },
          "recommended_model": {
            "type": ["string", "null"],
            "description": "Advisory specific model or profile suggested for the next agent."
          },
          "capability_reason": {
            "type": ["string", "null"],
            "description": "Brief human-readable reason describing required capabilities."
          },
          "context_hints": {
            "type": ["object", "null"],
            "description": "Scoped context to reduce token waste for the receiving agent.",
            "properties": {
              "entry_points": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Key functions or files to start reading from."
              },
              "relevant_symbols": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Important symbols (functions, classes, types) relevant to this handoff."
              },
              "estimated_tokens": {
                "type": "integer",
                "minimum": 0,
                "description": "Rough estimate of context tokens needed to understand the handoff scope."
              }
            },
            "additionalProperties": false
          },
          "prior_attempts": { "type": "integer", "minimum": 0, "default": 0 },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": ["string", "null"], "format": "date-time" },
          "stale_observation": {
            "type": "boolean",
            "default": false,
            "description": "True if a file in the handoff has been modified since the handoff was created."
          },
          "source_system": {
            "type": ["string", "null"],
            "description": "Optional provenance tag for external ingest sources (for example: agencysync)."
          },
          "source_run_id": {
            "type": ["string", "null"],
            "description": "Optional upstream run identifier from an external agent system."
          },
          "source_event_id": {
            "type": ["string", "null"],
            "description": "Optional upstream event identifier from an external agent system."
          },
          "state_history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["status", "agent", "timestamp"],
              "additionalProperties": false,
              "properties": {
                "status": { "type": "string", "enum": ["queued", "in_progress", "blocked", "ready_for_review", "approved", "merged", "escalated"] },
                "agent": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" },
                "timestamp": { "type": "string", "format": "date-time" },
                "reason": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
